// One page, five stops up the mountain. The 3D model (public/js/journey3d.js) follows
// the route as you scroll; each <section data-camp> is a stop.
import Shell from '../layouts/Shell.astro';
import CountryMap from '../components/CountryMap.astro';
import books from '../data/books.json';
import readingNow from '../data/reading-now.json';
import certs from '../data/certs.json';

const YEAR = new Date().getFullYear();

// "Currently - Reading": the Goodreads currently-reading shelf (refreshed at build).
// SERIES shows a series name in place of the book title, keyed by Goodreads book id.
const SERIES: Record<string, string> = { '22878967': 'The Licanius Trilogy' };
const now = readingNow[0];
const reading = now ? { url: now.url, label: SERIES[now.id] ?? now.title } : null;

// Reading shelf: this year's books in one row; "The full shelf" opens the last ~5 years.
const dated = books.filter((b) => b.cover && b.year);
const ROW_YEAR = dated.some((b) => b.year === YEAR) ? YEAR : Math.max(...dated.map((b) => b.year));
const ROW = dated.filter((b) => b.year === ROW_YEAR);
const FLOOR_YEAR = YEAR - 4; // a lone year just below the floor folds up into it
const shown = dated.filter((b) => b.year >= FLOOR_YEAR - 1);
const shelfYear = (b) => Math.max(b.year, FLOOR_YEAR);
const SHELF = [...new Set(shown.map(shelfYear))]
  .sort((a, b) => b - a)
  .map((year) => ({ year, books: shown.filter((b) => shelfYear(b) === year) }));
const bookTitle = (b) => `${b.title}${b.author ? ` - ${b.author}` : ''}`;
const bookAlt = (b) => `${b.title}${b.author ? `, by ${b.author}` : ''}`;

const CERTS = [...certs].reverse();

// Interactive map: Travel + Climbing shade countries; Mountaineering + Snowboarding are pins.
const MAP = {
  visited: ['us', 'pr', 'bs', 'es', 'gb', 'gr', 'cz', 'fr', 'nl', 'mx', 'au', 'br', 'no'],
  climbed: ['us', 'mx', 'br', 'no'],
  mountaineering: [
    { name: 'Mount Baker', lat: 48.7767, lng: -121.8144, status: 'summit', nudge: [18, 16] },
    { name: 'Mount Shuksan', lat: 48.8306, lng: -121.6022, status: 'summit' },
    { name: 'Mount Olympus', lat: 47.8014, lng: -123.7065, status: 'summit', nudge: [12, 0] },
    { name: 'Mount Rainier', lat: 46.8523, lng: -121.7603, status: 'attempt' },
    { name: 'Midsummer Dome, WY', lat: 42.77, lng: -109.21, status: 'summit' },
  ],
  snowboarding: [
    { name: 'Sugar Mountain, NC', lat: 36.1329, lng: -81.8637 },
    { name: 'Beech Mountain, NC', lat: 36.2019, lng: -81.8873 },
    { name: 'Appalachian Ski Mtn, NC', lat: 36.1586, lng: -81.6936 },
    { name: 'Cataloochee, NC', lat: 35.5945, lng: -83.0876 },
    { name: 'Wolf Ridge, NC', lat: 35.9758, lng: -82.6361 },
    { name: 'Snowshoe Mountain, WV', lat: 38.4121, lng: -79.9953 },
    { name: 'Copper Mountain, CO', lat: 39.5022, lng: -106.1517 },
    { name: 'Keystone, CO', lat: 39.6084, lng: -105.9437 },
    { name: 'Breckenridge, CO', lat: 39.4783, lng: -106.0667 },
    { name: 'Vail, CO', lat: 39.6061, lng: -106.355 },
    { name: 'Beaver Creek, CO', lat: 39.6042, lng: -106.5165 },
    { name: 'Bridger Bowl, MT', lat: 45.8179, lng: -110.9066 },
  ],
};
