<script is:inline>
  // highlight the stop you're reading in the left rail
  const links = [...document.querySelectorAll('.rail li')];
  document.querySelectorAll('[data-camp]').forEach((sec, i) => new IntersectionObserver(([e]) => {
    if (e.isIntersecting) links.forEach((l, j) => { l.classList.toggle('on', j === i); l.classList.toggle('done', j < i); });
  }, { rootMargin: '-40% 0px -55% 0px' }).observe(sec));
</script>
<script is:inline>
  // Contact form: posts to the Cloudflare Pages Function (functions/api/contact.js), which
  // emails via Resend. Works without JS as a plain POST; this shows the result inline.
  (function () {
    const form = document.querySelector('.contact-form');
    if (!form) return;
    const status = form.querySelector('.form-status'), button = form.querySelector('button[type="submit"]');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.hidden = true; button.disabled = true;
      try {
        const res = await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) { form.reset(); status.textContent = form.dataset.success; status.className = 'form-status ok'; }
        else { status.textContent = data.error || 'Something went wrong. Please try again.'; status.className = 'form-status err'; }
      } catch (_) {
        status.textContent = 'Something went wrong. Please try again.'; status.className = 'form-status err';
      } finally { status.hidden = false; button.disabled = false; }
    });
  })();
</script>

