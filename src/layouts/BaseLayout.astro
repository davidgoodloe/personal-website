---
import '../styles/global.css';
import EditMode from '../components/EditMode.astro';
import { ClientRouter, fade } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  /** Path (relative to the site) of the social share image. Defaults to the brand card. */
  ogImage?: string;
  wide?: boolean;
}

const {
  title = 'David Goodloe',
  description,
  ogImage = '/og-image.jpg',
  wide = false,
} = Astro.props;

// Site-wide default description (David's own words, from the home bio) used for
// SEO + social previews on any page that does not pass its own.
const DEFAULT_DESCRIPTION =
  'David Goodloe - working at the juncture of technology, scientific research, energy, ' +
  'sustainability, construction, software, and AI. Rock climber, mountaineer, snowboarder, ' +
  'reader, and traveler.';
const metaDescription = description ?? DEFAULT_DESCRIPTION;

// Absolute URLs for canonical + social tags (Astro.site is set in astro.config).
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const ogImageURL = Astro.site ? new URL(ogImage, Astro.site).href : ogImage;

// Normalize path (strip trailing slash) for active-nav matching.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/work', label: 'Work' },
  { href: '/adventure', label: 'Adventure' },
  { href: '/learning', label: 'Learning' },
  { href: '/about', label: 'About' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');

// "Keep exploring" loops through the nav in order (Home -> Work -> ... -> About -> Home).
const currentIndex = nav.findIndex((n) => isActive(n.href));
const nextPage = currentIndex >= 0 ? nav[(currentIndex + 1) % nav.length] : null;

// --- Structured data (JSON-LD) ---
// Helps search + AI answer engines (ChatGPT, Perplexity, Google AI Overviews)
// reliably identify who David is. Facts here are David's to confirm/extend.
//   [TODO: David confirm] - LinkedIn / X profile URLs to add to `sameAs` below,
//   and whether the employer name/URL should read differently.
const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://davidgoodloe.ai';
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'David Goodloe',
  url: siteUrl + '/',
  image: ogImageURL,
  jobTitle: 'Director, BranchRegenerate™ Business Unit',
  worksFor: {
    '@type': 'Organization',
    name: 'Branch Technology',
    url: 'https://www.branch.technology',
  },
  homeLocation: {
    '@type': 'Place',
    name: 'Chattanooga, Tennessee',
  },
  knowsAbout: ['Artificial Intelligence', 'Software Development', 'DevOps', 'Sustainability'],
  sameAs: [
    'https://github.com/davidgoodloe',
    'https://www.goodreads.com/user/show/203579059-david-goodloe',
    // [TODO: David confirm] - add LinkedIn + X (Twitter) profile URLs here.
  ],
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'David Goodloe',
  url: siteUrl + '/',
};

// Cloudflare Web Analytics (cookieless). The beacon renders only when the token
// is set as a build env var (PUBLIC_CF_BEACON_TOKEN) in Cloudflare Pages - never
// hardcoded here. No token -> no script -> nothing to track.
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap"
    />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL} />

    {/* Open Graph - rich previews on LinkedIn, iMessage, Slack, Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="David Goodloe" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="David Goodloe - davidgoodloe.ai" />
    <meta property="og:locale" content="en_US" />

    {/* Twitter / X card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    {/* Structured data for search + AI answer engines */}
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {
      /* Home is the entry to the Home<->About portrait morph. Prefetch the About
         cluster images here (low priority) so the two side photos are already cached
         when the user navigates in - otherwise they pop in a beat after the lead
         morphs. */
      path === '/' && (
        <>
          <link rel="prefetch" as="image" href="/about-portrait.jpg" />
          <link rel="prefetch" as="image" href="/about-portrait-2.jpg" />
          <link rel="prefetch" as="image" href="/about-portrait-3.jpg" />
        </>
      )
    }
    <ClientRouter />
  </head>
  <body>
    <div class:list={['site', { wide }]}>
      <header class="site-header" transition:persist>
        <a class:list={['home-link', { 'home-large': path === '/' }]} href="/">David Goodloe</a>
        <nav class="nav" aria-label="Primary">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>

      <main transition:animate={fade({ duration: '0.25s' })}>
        <slot />
        {
          nextPage && (
            <a class="page-next" href={nextPage.href} aria-label={`Keep exploring: ${nextPage.label}`}>
              <span class="page-next-label">Keep exploring</span>
              <span class="page-next-target">
                {nextPage.label}
                <span class="page-next-arrow" aria-hidden="true">&rarr;</span>
              </span>
            </a>
          )
        }
      </main>

      <footer class="site-footer">
        <span>&copy; {new Date().getFullYear()} David Goodloe</span>
        <span><a href="/">Home</a></span>
      </footer>
    </div>
    {import.meta.env.DEV && <EditMode />}
    {
      /* Cloudflare Web Analytics beacon - cookieless, only when a token is configured. */
      cfBeaconToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
        />
      )
    }
    <script>
      // The header persists across view transitions, so its server-rendered
      // aria-current goes stale - refresh the active nav link on every navigation.
      const updateActiveNav = () => {
        const path = location.pathname.replace(/\/+$/, '') || '/';
        document.querySelectorAll('.nav a').forEach((a) => {
          const href = a.getAttribute('href') || '';
          const active = href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
          if (active) a.setAttribute('aria-current', 'page');
          else a.removeAttribute('aria-current');
        });
        // Enlarge the header wordmark on the home page only (the persisted header's
        // server-rendered class goes stale after a client-side navigation).
        const home = document.querySelector('.home-link');
        if (home) home.classList.toggle('home-large', path === '/');
      };
      document.addEventListener('astro:page-load', updateActiveNav);
    </script>
  </body>
</html>
