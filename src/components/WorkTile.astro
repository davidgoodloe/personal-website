---
/**
 * A single project tile in the Work bento grid. Image-led, grows on hover, and
 * opens a larger detail view on click (handled by the lightbox in work.astro,
 * which reads the data-* attributes here). `domain` picks the category accent
 * (see --c-* tokens in global.css).
 */
type Domain = 'space' | 'build' | 'rnd' | 'mat' | 'soft';
interface Img { src: string; alt: string; fit?: 'cover' | 'contain'; }

interface Props {
  title: string;
  tag: string;
  domain: Domain;
  images: Img[];
  desc: string;
  feature?: boolean;
}

const { title, tag, domain, images, desc, feature = false } = Astro.props;
const color = `var(--c-${domain})`;
const cover = images[0];
---

<article
  class:list={['tile', { feature }]}
  tabindex="0"
  role="button"
  aria-label={`${title} - open details`}
  data-images={JSON.stringify(images)}
  data-title={title}
  data-tag={tag}
  data-desc={desc}
  data-color={color}
>
  <img src={cover.src} alt={cover.alt} loading="lazy" />
  <div class="veil"></div>
  <div class="body">
    <span class="tag"><span class="dot" style={`--tagc:${color}`}></span>{tag}</span>
    <h3>{title}</h3>
  </div>
</article>

<style>
  .tile {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    cursor: pointer;
    border: 1px solid var(--border);
    background: var(--code-bg);
    transition: transform 0.28s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.28s ease;
  }
  .tile.feature {
    grid-column: span 2;
    grid-row: span 2;
  }
  .tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(18, 15, 11, 0.85) 0%,
      rgba(18, 15, 11, 0.3) 45%,
      rgba(18, 15, 11, 0.02) 72%
    );
  }
  .body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.85rem 1rem;
    color: #fdfbf6;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.62rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  .tag .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--tagc, #fff);
  }
  .body h3 {
    margin: 0;
    font-size: 1rem;
    letter-spacing: -0.01em;
    font-weight: 600;
    line-height: 1.2;
  }
  .tile.feature h3 {
    font-size: 1.45rem;
  }
  .tile:hover,
  .tile:focus-visible {
    transform: scale(1.035);
    z-index: 3;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.32);
    outline: none;
  }
  .tile:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .tile:hover img,
  .tile:focus-visible img {
    transform: scale(1.07);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile,
    .tile img {
      transition: none;
    }
    .tile:hover,
    .tile:focus-visible {
      transform: none;
    }
  }
</style>
